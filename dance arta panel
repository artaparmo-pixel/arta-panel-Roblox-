-- داده‌ها
-- ============================================
local toggleData = {}
local animationTracks = {}
local allDances = {}

local function getHumanoidSafe()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("Humanoid"), char
end

local function resetAllToggles(exceptName)
    for name, data in pairs(toggleData) do
        if name ~= exceptName and data.isActive then
            data.isActive = false
            data.button.Text = name.." | خاموش"
            data.button.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
            if animationTracks[name] then
                for _, track in ipairs(animationTracks[name]) do
                    track:Stop(0.2)
                end
            end
        end
    end
end

-- ============================================
-- ساخت Toggle
-- ============================================
local orderCounter = 100

local function createToggleButton(name, animationData, speed)
    orderCounter = orderCounter + 1
    toggleData[name] = {isActive = false}
    animationTracks[name] = {}

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -6, 0, buttonHeight)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
    btn.Text = name.." | خاموش"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 13
    btn.BorderSizePixel = 0
    btn.LayoutOrder = orderCounter
    btn.Parent = scroll

    toggleData[name].button = btn

    local crn = Instance.new("UICorner")
    crn.CornerRadius = UDim.new(0, 6)
    crn.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 170, 255)
    stroke.Thickness = 1
    stroke.Transparency = 0.5
    stroke.Parent = btn

    btn.MouseButton1Click:Connect(function()
        playClickSound()
        local data = toggleData[name]
        data.isActive = not data.isActive

        local humanoid, char = getHumanoidSafe()
        local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid

        if data.isActive then
            resetAllToggles(name)
            btn.Text = name.." | روشن"
            btn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)

            local ids = type(animationData) == "table" and animationData or {animationData}
            animationTracks[name] = {}
for _, id in ipairs(ids) do
                local anim = Instance.new("Animation")
                anim.AnimationId = id
                local success, track = pcall(function()
                    return animator:LoadAnimation(anim)
                end)
                if success and track then
                    track.Priority = Enum.AnimationPriority.Action4
                    track.Looped = true
                    table.insert(animationTracks[name], track)
                    track:Play()
                    track:AdjustSpeed(speed)
                end
            end
        else
            btn.Text = name.." | خاموش"
            btn.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
            if animationTracks[name] then
                for _, track in ipairs(animationTracks[name]) do
                    track:Stop(0.2)
                end
            end
        end
    end)
end

