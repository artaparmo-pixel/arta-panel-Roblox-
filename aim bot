local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude

-- =================== CYCLE TARGET ===================
local function CycleTarget()
    TargetIndex = TargetIndex % #TargetParts + 1
    Settings.TargetPart = TargetParts[TargetIndex]
    if TargetBtn then
        TargetBtn.Text = "Target: " .. Settings.TargetPart
    end
    print("Target changed to: " .. Settings.TargetPart)
end

-- =================== WALLCHECK ===================
local function isVisible(targetCharacter)
    if not Settings.VisibleCheck then return true end
    local targetPart = targetCharacter:FindFirstChild(Settings.TargetPart)
    if not targetPart then return false end
    
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, targetCharacter}
    local camPos = Camera.CFrame.Position
    local raycastResult = workspace:Raycast(camPos, (targetPart.Position - camPos), raycastParams)
    
    return raycastResult == nil
end

-- =================== FRIEND CHECK ===================
local function isFriend(player)
    for _, friendName in pairs(FriendList) do
        if player.Name == friendName then
            return true
        end
    end
    return false
end

-- =================== AIMBOT LOGIC ===================
local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = Settings.FOV

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            -- SKIP IF FRIEND
            if isFriend(player) then
                continue
            end
            
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if not humanoid or humanoid.Health <= 0 then continue end
            
            local targetPart = player.Character:FindFirstChild(Settings.TargetPart)
            if not targetPart then 
                targetPart = player.Character:FindFirstChild("HumanoidRootPart")
                if not targetPart then continue end
            end
            
            local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
            if onScreen then
                local mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                
                if distance < shortestDistance then
                    if isVisible(player.Character) then
                        shortestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

-- =================== UPDATE PLAYER ===================
local function updatePlayerHighlight(player)
    if player == LocalPlayer then return end
    local char = player.Character
    if not char then return end
    
    -- Remove old highlight
    if char:FindFirstChild("DeltaWH") then
        char.DeltaWH:Destroy()
    end
    
    -- If Wallhack is off, do nothing
    if not Settings.WallhackEnabled then return end
    
    -- Check if player is a friend
    local isFriendPlayer = isFriend(player)
    
    -- Create new highlight
    local hl = Instance.new("Highlight")
    hl.Name = "DeltaWH"
    
    if isFriendPlayer then
        -- FRIEND: Green with dark outline
        hl.FillColor = Color3.fromRGB(0, 255, 0)
        hl.OutlineColor = Color3.fromRGB(20, 20, 20) -- dark border
        hl.FillTransparency = 0.3
        hl.OutlineTransparency = 0
    else
        -- ENEMY: Red with white outline (default)
        hl.FillColor = Color3.fromRGB(255, 0, 0)
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
    end
    
    hl.Adornee = char
    hl.Parent = char
end

-- =================== ESP ===================
local function applyHighlight(player)
    if player == LocalPlayer then return end
    
    local function setup(char)
        if not char then return end
        char:WaitForChild("HumanoidRootPart", 5)
        char:WaitForChild("Humanoid", 5)
        updatePlayerHighlight(player)
    end
    
    if player.Character then setup(player.Character) end
    player.CharacterAdded:Connect(setup)
end

for _, p in pairs(Players:GetPlayers()) do applyHighlight(p) end
Players.PlayerAdded:Connect(applyHighlight)

local function updateAllWH()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            updatePlayerHighlight(p)
        end
    end
end

