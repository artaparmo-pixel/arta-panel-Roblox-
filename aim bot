-- =================== HOTKEYS ===================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    -- T key: toggle Head/Torso
    if input.KeyCode == Enum.KeyCode.T then
        CycleTarget()
        TargetDisplay.Text = "target " .. Settings.TargetPart
        if TargetBtn then
            TargetBtn.Text = "Target: " .. Settings.TargetPart
        end
    end
    
    -- F key: toggle FOV circle visibility
    if input.KeyCode == Enum.KeyCode.F then
        Settings.ShowFOV = not Settings.ShowFOV
        FOVFrame.Visible = Settings.ShowFOV
        if FOVBtn then
            FOVBtn.Text = "Show FOV: " .. (Settings.ShowFOV and "ON" or "OFF")
            FOVBtn.BackgroundColor3 = Settings.ShowFOV and Color3.fromRGB(50, 150, 50) or Color3.fromRGB(150, 50, 50)
        end
        print("FOV Circle: " .. (Settings.ShowFOV and "VISIBLE" or "HIDDEN"))
    end
end)

-- =================== MAIN LOOP ===================
RunService.RenderStepped:Connect(function()
    if Settings.AimbotEnabled then
        local target = getClosestPlayer()
        if target and target.Character then
            local targetPart = target.Character:FindFirstChild(Settings.TargetPart)
            if not targetPart then
                targetPart = target.Character:FindFirstChild("HumanoidRootPart")
            end
            if targetPart then
                local targetPos = targetPart.Position
                local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPos)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 1 - Settings.Smoothness)
            end
        end
    end
end)
