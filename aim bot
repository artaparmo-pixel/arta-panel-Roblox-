-- =================== SUBMENU LOGIC ===================
local function UpdateFriendDisplay()
    for _, child in pairs(FriendDisplay:GetChildren()) do
        if child ~= EmptyLabel then
            child:Destroy()
        end
    end

    if #FriendList == 0 then
        EmptyLabel.Visible = true
        FriendDisplay.CanvasSize = UDim2.new(0, 0, 0, 0)
        return
    end

    EmptyLabel.Visible = false
    local yOffset = 0
    for _, name in pairs(FriendList) do
        local label = Instance.new("TextLabel", FriendDisplay)
        label.Size = UDim2.new(1, 0, 0, 25)
        label.Position = UDim2.new(0, 0, 0, yOffset)
        label.BackgroundTransparency = 1
        label.Text = "• " .. name
        label.TextColor3 = Color3.new(1,1,1)
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Font = Enum.Font.SourceSans
        label.TextSize = 14
        yOffset = yOffset + 25
    end
    FriendDisplay.CanvasSize = UDim2.new(0, 0, 0, yOffset)
end

-- Add friend
AddFriendBtn.MouseButton1Click:Connect(function()
    local name = FriendInput.Text:gsub("^%s*(.-)%s*$", "%1")
    if name == "" then return end
    
    local player = Players:FindFirstChild(name)
    if not player then
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Friend System",
            Text = "Player not found!",
            Duration = 2
        })
        return
    end
    
    for _, v in pairs(FriendList) do
        if v == name then return end
    end
    table.insert(FriendList, name)
    FriendInput.Text = ""
    UpdateFriendDisplay()
    
    -- Update ESP for this friend
    if player then
        updatePlayerHighlight(player)
    end
end)

-- Remove friend
RemoveFriendBtn.MouseButton1Click:Connect(function()
    local name = FriendInput.Text:gsub("^%s*(.-)%s*$", "%1")
    if name == "" then return end
    for i, v in pairs(FriendList) do
        if v == name then
            table.remove(FriendList, i)
            FriendInput.Text = ""
            UpdateFriendDisplay()
            
            -- Update ESP for this ex-friend (back to red)
            local player = Players:FindFirstChild(name)
            if player then
                updatePlayerHighlight(player)
            end
            return
        end
    end
    
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Friend System",
        Text = "Friend not found in list!",
        Duration = 2
    })
end)

