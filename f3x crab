local function BuildRestaurant()
    if not F3XTool then warn("❌ F3X نیست") return end
    
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local look = hrp.CFrame.LookVector
    local base = hrp.Position + Vector3.new(look.X, 0, look.Z).Unit * 30
    base = Vector3.new(base.X, hrp.Position.Y, base.Z)
    
    print("🏗️ ساخت...")
    local t0 = tick()
    
    -- کف
    F3XPart("Floor", Vector3.new(60,1,50), base, Color3.fromRGB(210,170,120), Enum.Material.WoodPlanks)
    F3XPart("FloorEntrance", Vector3.new(20,0.5,10), base+Vector3.new(0,0.6,25), Color3.fromRGB(120,120,120), Enum.Material.Cobblestone)
    
    -- پیشخوان
    F3XPart("Counter", Vector3.new(30,4,3), base+Vector3.new(0,2,-18), Color3.fromRGB(80,50,30), Enum.Material.Wood)
    F3XPart("CounterTop", Vector3.new(31,0.5,4), base+Vector3.new(0,4.5,-18), Color3.fromRGB(230,230,230), Enum.Material.Marble)
    
    -- صندوق
    F3XPart("CashRegister1", Vector3.new(2.5,2,2), base+Vector3.new(-10,6,-18), Color3.fromRGB(40,40,40), Enum.Material.Metal)
    F3XPart("CashRegister2", Vector3.new(2.5,2,2), base+Vector3.new(10,6,-18), Color3.fromRGB(40,40,40), Enum.Material.Metal)
    
    -- میزها
    local tables = {
        {-20,-5}, {0,-5}, {20,-5},
        {-20,5}, {0,5}, {20,5},
        {-20,15}, {0,15}, {20,15}
    }
    for i, t in ipairs(tables) do
        local tPos = base + Vector3.new(t[1], 0, t[2])
        F3XPart("TableBase"..i, Vector3.new(2,3,2), tPos+Vector3.new(0,1.5,0), Color3.fromRGB(80,50,20), Enum.Material.Wood)
        F3XPart("TableTop"..i, Vector3.new(7,0.5,7), tPos+Vector3.new(0,3,0), Color3.fromRGB(150,100,50), Enum.Material.Wood)
        for j = 1, 4 do
            local offset
            if j == 1 then offset = Vector3.new(4.5,0,0)
            elseif j == 2 then offset = Vector3.new(-4.5,0,0)
            elseif j == 3 then offset = Vector3.new(0,0,4.5)
            else offset = Vector3.new(0,0,-4.5) end
            F3XPart("Seat"..i.."_"..j, Vector3.new(2,0.5,2), tPos+offset+Vector3.new(0,1.5,0), Color3.fromRGB(200,60,60), Enum.Material.SmoothPlastic)
            F3XPart("Back"..i.."_"..j, Vector3.new(2,2.5,0.3), tPos+offset+offset.Unit*0.9+Vector3.new(0,3,0), Color3.fromRGB(200,60,60), Enum.Material.SmoothPlastic)
        end
    end
    
    -- خرچنگ‌ها
    for i, x in ipairs({-12, -6, 0, 6, 12}) do
        F3XPart("CrabBody"..i, Vector3.new(3.5,2.2,2.8), base+Vector3.new(x,7,-18), Color3.fromRGB(230,30,30), Enum.Material.SmoothPlastic)
        F3XPart("CrabHead"..i, Vector3.new(2.2,1.8,1.8), base+Vector3.new(x,7.6,-15.5), Color3.fromRGB(240,50,50), Enum.Material.SmoothPlastic)
        F3XPart("Eye1_"..i, Vector3.new(0.5,0.5,0.5), base+Vector3.new(x-0.5,7.9,-14.9), Color3.fromRGB(255,255,255), Enum.Material.Neon)
        F3XPart("Eye2_"..i, Vector3.new(0.5,0.5,0.5), base+Vector3.new(x+0.5,7.9,-14.9), Color3.fromRGB(255,255,255), Enum.Material.Neon)
        F3XPart("ClawL"..i, Vector3.new(2,0.6,1), base+Vector3.new(x-2.2,6.5,-19), Color3.fromRGB(230,30,30), Enum.Material.SmoothPlastic)
        F3XPart("ClawR"..i, Vector3.new(2,0.6,1), base+Vector3.new(x+2.2,6.5,-19), Color3.fromRGB(230,30,30), Enum.Material.SmoothPlastic)
    end
    
    -- عکس
    local pic = F3XPart("WallPicture", Vector3.new(26,16,0.4), base+Vector3.new(0,8.2,-23.6), Color3.fromRGB(255,255,255), Enum.Material.SmoothPlastic)
    if pic then AddDecal(pic, "94436187842563") end
    
    -- تابلو
    F3XPart("Sign", Vector3.new(30,6,0.5), base+Vector3.new(0,24,-25), Color3.fromRGB(255,200,50), Enum.Material.Neon)
    
    -- چراغ‌ها
    for i, x in ipairs({-20, -12, -4, 4, 12, 20}) do
        F3XPart("Lamp"..i, Vector3.new(3,1,3), base+Vector3.new(x,20.5,0), Color3.fromRGB(255,255,180), Enum.Material.Neon)
    end
    
    -- ستون‌ها
    for i, pos in ipairs({{-28,20}, {28,20}, {-28,-20}, {28,-20}}) do
        F3XPart("Pillar"..i, Vector3.new(2.5,22,2.5), base+Vector3.new(pos[1],11,pos[2]), Color3.fromRGB(240,240,240), Enum.Material.Marble)
    end
    
    -- فرش
    F3XPart("Carpet", Vector3.new(20,0.2,12), base+Vector3.new(0,1,15), Color3.fromRGB(150,20,20), Enum.Material.Fabric)
    
    -- آکواریوم
    F3XPart("Aquarium", Vector3.new(15,8,1), base+Vector3.new(0,14,-24), Color3.fromRGB(50,150,255), Enum.Material.Glass)
    
    print("🦀 تمام شد! زمان: " .. string.format("%.1f", tick() - t0) .. " ثانیه")
end
