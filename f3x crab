local function FindSyncAPI()
    local tool
    for _, v in pairs(LocalPlayer:GetDescendants()) do
        if v.Name == "SyncAPI" then tool = v.Parent end
    end
    if not tool and LocalPlayer.Character then
        for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
            if v.Name == "SyncAPI" then tool = v.Parent end
        end
    end
    if not tool then
        for _, v in pairs(ReplicatedStorage:GetDescendants()) do
            if v.Name == "SyncAPI" then tool = v.Parent end
        end
    end
    if not tool then
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "SyncAPI" then tool = v.Parent end
        end
    end
    return tool
end

local F3XTool = FindSyncAPI()

local function _(args)
    if not F3XTool then
        F3XTool = FindSyncAPI()
        if not F3XTool then return end
    end
    local api = F3XTool:FindFirstChild("SyncAPI")
    local remote = api and api:FindFirstChild("ServerEndpoint")
    if remote then remote:InvokeServer(unpack(args)) end
end

local function CreatePart(cf)
    _({ [1] = "CreatePart", [2] = "Normal", [3] = cf, [4] = workspace })
end
local function SetName(part, name)
    _({ [1] = "SetName", [2] = { [1] = part }, [3] = name })
end
local function SetColor(part, color)
    _({ [1] = "SyncColor", [2] = { [1] = { ["Part"] = part, ["Color"] = color } } })
end
local function SetMaterial(part, material)
    _({ [1] = "SyncMaterial", [2] = { [1] = { ["Part"] = part, ["Material"] = material } } })
end
local function SetSize(part, size)
    _({ [1] = "SyncSize", [2] = { [1] = { ["Part"] = part, ["Size"] = size } } })
end
local function SetLocked(part, locked)
    _({ [1] = "SetLocked", [2] = { [1] = part }, [3] = locked })
end
local function AddDecal(part, textureId)
    _({ [1] = "CreateTextures", [2] = { [1] = { ["Part"] = part, ["Face"] = Enum.NormalId.Front, ["TextureType"] = "Decal" } } })
    task.wait(0.05)
    _({ [1] = "SyncTexture", [2] = { [1] = { ["Part"] = part, ["Face"] = Enum.NormalId.Front, ["TextureType"] = "Decal", ["Texture"] = "rbxassetid://" .. textureId } } })
end

local function F3XPart(name, size, pos, color, material)
    local cf = CFrame.new(pos)
    local before = {}
    for _, obj in pairs(workspace:GetChildren()) do
        if obj:IsA("BasePart") then before[obj] = true end
    end
    CreatePart(cf)
    task.wait(0.01)
    local found, minDist = nil, 3
    for _, obj in pairs(workspace:GetChildren()) do
        if obj:IsA("BasePart") and not before[obj] then
            local d = (obj.Position - pos).Magnitude
            if d < minDist then minDist = d; found = obj end
        end
    end
    if not found then return nil end
    SetName(found, name)
    SetSize(found, size)
    SetColor(found, color)
    SetMaterial(found, material)
    SetLocked(found, true)
    return found
end

