-- ============================================================
-- انتخاب پارت (نسخه اصلاح شده)
-- ============================================================
local function SelectPart()
    local closest = nil
    local minDist = 50
    
    for _, part in pairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") then
            -- کاراکترها رو نادیده بگیر
            local isChar = false
            if part.Parent and part.Parent:FindFirstChildOfClass("Humanoid") then
                isChar = true
            end
            
            -- پارتی که قبلاً انتخاب شده رو نادیده بگیر
            if not isChar and part ~= LastPart then
                local dist = (part.Position - hrp.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    closest = part
                end
            end
        end
    end
    
    -- اگه پارت جدید پیدا شد
    if closest then
        LastPart = closest
        print("✅ پارت جدید: " .. closest.Name .. " | فاصله: " .. math.floor(minDist))
        return closest
    end
    
    -- اگه پارتی پیدا نشد، همه رو بگرد (حتی قبلی)
    for _, part in pairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") then
            local isChar = false
            if part.Parent and part.Parent:FindFirstChildOfClass("Humanoid") then
                isChar = true
            end
            
            if not isChar then
                local dist = (part.Position - hrp.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    closest = part
                end
            end
        end
    end
    
    if closest then
        LastPart = closest
        print("✅ پارت (دور): " .. closest.Name)
    end
    
    return closest
end

-- ============================================================
-- کنترل پارت
-- ============================================================
local function MovePart(offset)
    if not ControlledPart or not ControlledPart.Parent then return end
    local newCF = ControlledPart.CFrame + offset
    pcall(function()
        remote:InvokeServer("SyncMove", {{Part = ControlledPart, CFrame = newCF}})
    end)
end

local function RotatePart(angle)
    if not ControlledPart or not ControlledPart.Parent then return end
    local newCF = ControlledPart.CFrame * CFrame.Angles(0, math.rad(angle), 0)
    pcall(function()
        remote:InvokeServer("SyncMove", {{Part = ControlledPart, CFrame = newCF}})
    end)
end

local function MovePartUp(amount)
    if not ControlledPart or not ControlledPart.Parent then return end
    local newCF = ControlledPart.CFrame + Vector3.new(0, amount, 0)
    pcall(function()
        remote:InvokeServer("SyncMove", {{Part = ControlledPart, CFrame = newCF}})
    end)
end
local function ResizePart(amount)
    if not ControlledPart or not ControlledPart.Parent then return end
    local newSize = ControlledPart.Size + Vector3.new(amount, amount, amount)
    if newSize.X < 1 then newSize = Vector3.new(1, 1, 1) end
    if newSize.X > 50 then newSize = Vector3.new(50, 50, 50) end
    pcall(function()
        remote:InvokeServer("SyncResize", {{Part = ControlledPart, Size = newSize, CFrame = ControlledPart.CFrame}})
    end)
end

local function ColorPart(color)
    if not ControlledPart or not ControlledPart.Parent then return end
    pcall(function()
        remote:InvokeServer("SyncColor", {{Part = ControlledPart, Color = color}})
    end)
end

local function DeletePart()
    if ControlledPart and ControlledPart.Parent then
        pcall(function()
            remote:InvokeServer("Remove", {ControlledPart})
        end)
        ControlledPart = nil
    end
end

local function FacePlayer()
    if not ControlledPart or not ControlledPart.Parent then return end
    local myHrp = char:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    local newCF = CFrame.new(ControlledPart.Position, myHrp.Position)
    pcall(function()
        remote:InvokeServer("SyncMove", {{Part = ControlledPart, CFrame = newCF}})
    end)
end

