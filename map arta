for i, partData in ipairs(parts) do
    local pos = parseVector(partData.Position or "(0,0,0)")
    local rot = parseVector(partData.Rotation or "(0,0,0)")
    local size = parseVector(partData.Size or "(1,1,1)")
    local color = parseColor(partData.Color or "1,1,1")
    local material = parseMaterial(partData.Material or "Plastic")
    local shape = parseShape(partData.Shape or "Block")
    local transparency = tonumber(partData.Transparency) or 0
    
    local cframe = CFrame.new(pos) * CFrame.Angles(
        math.rad(rot.X), math.rad(rot.Y), math.rad(rot.Z)
    )
    
    local newPart = remote:InvokeServer("CreatePart", "Normal", cframe, Player.Character)
    
    if newPart then
        FireMassiveSync("SyncResize", {{Part = newPart, Size = size, CFrame = cframe}})
        FireMassiveSync("SyncColor", {{Part = newPart, Color = color}})
        FireMassiveSync("SyncMaterial", {{Part = newPart, Material = material}})
        FireMassiveSync("SyncShape", {{Part = newPart, Shape = shape}})
        
        if transparency > 0 then
            FireMassiveSync("SyncTransparency", {{Part = newPart, Transparency = transparency}})
        end
        
        for key, value in pairs(partData) do
            local face = key:match("^Decal%.(%w+)$")
            if face then
                FireMassiveSync("CreateDecal", {{Part = newPart, Face = face, Texture = "rbxassetid://" .. value}})
            end
        end
        
        if partData.SpawnPoint == "True" then
            FireMassiveSync("SetSpawn", {{Part = newPart}})
        end
    end
    
    if i % 10 == 0 then
        print("⏳ " .. i .. "/" .. #parts)
    end
    
    task.wait(0.03)
end

SetFreeze(false)
print("✅ مپ ساخته شد! " .. #parts .. " پارت")
