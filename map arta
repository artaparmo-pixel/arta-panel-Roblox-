print("⏳ تجزیه دیتا...")

local function parseVector(str)
    local x, y, z = str:match("%(([%d%.%-]+),%s*([%d%.%-]+),%s*([%d%.%-]+)%)")
    return Vector3.new(tonumber(x) or 0, tonumber(y) or 0, tonumber(z) or 0)
end

local function parseColor(str)
    local r, g, b = str:match("([%d%.]+),%s*([%d%.]+),%s*([%d%.]+)")
    return Color3.new(tonumber(r) or 1, tonumber(g) or 1, tonumber(b) or 1)
end

local function parseMaterial(str)
    return Enum.Material[str] or Enum.Material.Plastic
end

local function parseShape(str)
    if str == "Cylinder" then return Enum.PartType.Cylinder end
    if str == "Ball" then return Enum.PartType.Ball end
    if str == "Wedge" then return Enum.PartType.Wedge end
    return Enum.PartType.Block
end

-- تجزیه دیتا
local parts = {}
local currentPart = nil

for line in RawData:gmatch("[^\r\n]+") do
    line = line:gsub("^%s+", ""):gsub("%s+$", "")
    
    if line:match("^Part%s+%d+:") then
        if currentPart then
            table.insert(parts, currentPart)
        end
        currentPart = {}
    elseif currentPart then
        local key, value = line:match("^([%w%.]+):%s*(.+)$")
        if key and value then
            currentPart[key] = value
        end
    end
end

if currentPart then
    table.insert(parts, currentPart)
end

print("📦 " .. #parts .. " پارت پیدا شد")

-- فریز کردن پلیر
local char = Player.Character
if char and char:FindFirstChild("HumanoidRootPart") then
    char.HumanoidRootPart.Anchored = true
end

print("⏳ ساخت مپ...")

-- ساخت پارت‌ها
for i, partData in ipairs(parts) do
    local pos = parseVector(partData.Position or "(0,0,0)")
    local rot = parseVector(partData.Rotation or "(0,0,0)")
    local size = parseVector(partData.Size or "(1,1,1)")
    local color = parseColor(partData.Color or "1,1,1")
    local material = parseMaterial(partData.Material or "Plastic")
    local shape = parseShape(partData.Shape or "Block")
    local transparency = tonumber(partData.Transparency) or 0
    
    local cframe = CFrame.new(pos) * CFrame.Angles(
        math.rad(rot.X), math.rad(rot.Y), math.rad(rot.Z)
    )
    
    local newPart = remote:InvokeServer("CreatePart", "Normal", cframe, char)
    
    if newPart then
        remote:InvokeServer("SyncResize", {{Part = newPart, Size = size, CFrame = cframe}})
        remote:InvokeServer("SyncColor", {{Part = newPart, Color = color}})
        remote:InvokeServer("SyncMaterial", {{Part = newPart, Material = material}})
        
        if transparency > 0 then
            remote:InvokeServer("SyncTransparency", {{Part = newPart, Transparency = transparency}})
        end
        
        -- Decal
        for key, value in pairs(partData) do
            local face = key:match("^Decal%.(%w+)$")
            if face then
                remote:InvokeServer("CreateDecal", {{Part = newPart, Face = face, Texture = "rbxassetid://" .. value}})
            end
        end
        
        -- SpawnPoint
        if partData.SpawnPoint == "True" then
            remote:InvokeServer("SetSpawn", {{Part = newPart}})
        end
    end
    
    if i % 10 == 0 then
        print("⏳ " .. i .. "/" .. #parts)
    end
    
    task.wait(0.03)
end

