-- ============================================================
-- ===== چک F3X =====
-- ============================================================
local function FindSyncAPI()
    local tool
    for _, v in pairs(LocalPlayer:GetDescendants()) do
        if v.Name == "SyncAPI" then tool = v.Parent end
    end
    if not tool and LocalPlayer.Character then
        for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
            if v.Name == "SyncAPI" then tool = v.Parent end
        end
    end
    if not tool then
        for _, v in pairs(ReplicatedStorage:GetDescendants()) do
            if v.Name == "SyncAPI" then tool = v.Parent end
        end
    end
    if not tool then
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "SyncAPI" then tool = v.Parent end
        end
    end
    return tool
end

local F3XTool = FindSyncAPI()
local HasF3X = F3XTool ~= nil

if HasF3X then
    print("✅ F3X هست → همه می‌بینن!")
else
    print("⚠️ F3X نیست → فقط خودت می‌بینی")
end

-- ============================================================
-- ===== F3X Sync =====
-- ============================================================
local function _(args)
    if not F3XTool then
        F3XTool = FindSyncAPI()
        if not F3XTool then return end
    end
    local api = F3XTool:FindFirstChild("SyncAPI")
    local remote = api and api:FindFirstChild("ServerEndpoint")
    if remote then
        pcall(function() remote:InvokeServer(unpack(args)) end)
    end
end

-- ============================================================
-- ===== پیدا کردن NPC =====
-- ============================================================
local function FindNPCs()
    local npcs = {}
    for _, obj in pairs(workspace:GetChildren()) do
        if obj:IsA("Model") then
            local humanoid = obj:FindFirstChildOfClass("Humanoid")
            local hrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("UpperTorso")
            if humanoid and hrp and not Players:GetPlayerFromCharacter(obj) then
                table.insert(npcs, {Model = obj, Humanoid = humanoid, HRP = hrp, Name = obj.Name})
            end
        end
    end
    return npcs
end

local NPCs = FindNPCs()
print("✅ " .. #NPCs .. " NPC پیدا شد")

if #NPCs == 0 then
    warn("❌ NPC نیست")
    return
end

-- ============================================================
-- ===== متغیرها =====
-- ============================================================
local SelectedNPC = NPCs[1]
local IsInNPC = false
local OriginalCFrame = nil
local OriginalWalkSpeed = 16
local OriginalJumpPower = 50
local Camera = workspace.CurrentCamera
local LastMoveTime = 0

-- ============================================================
-- ===== ورود به NPC =====
-- ============================================================
local function EnterNPC()
    if not SelectedNPC or not SelectedNPC.Model.Parent then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    
    OriginalCFrame = hrp.CFrame
    OriginalWalkSpeed = hum.WalkSpeed
    OriginalJumpPower = hum.JumpPower
    
    -- بدن خودت رو AFK کن
hum.WalkSpeed = 0
    hum.JumpPower = 0
    
    -- دوربین بره روی NPC
    Camera.CameraSubject = SelectedNPC.Humanoid
    
    IsInNPC = true
    print("✅ داخل NPC: " .. SelectedNPC.Name)
    print("👤 بدن خودت AFK موند")
    
    if HasF3X then
        print("🌐 همه می‌بینن!")
    else
        print("⚠️ فقط خودت می‌بینی")
    end
end

-- ============================================================
-- ===== خروج از NPC =====
-- ============================================================
local function ExitNPC()
    if not IsInNPC then return end
    
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = OriginalWalkSpeed
            hum.JumpPower = OriginalJumpPower
            Camera.CameraSubject = hum
        end
    end
    
    if SelectedNPC and SelectedNPC.Humanoid then
        SelectedNPC.Humanoid:Move(Vector3.new(0, 0, 0), false)
    end
    
    IsInNPC = false
    print("✅ از NPC خارج شدی")
end

-- ============================================================
-- ===== حرکت NPC (با F3X یا معمولی) =====
-- ============================================================
local function MoveNPC(direction)
    if not SelectedNPC or not SelectedNPC.Model.Parent then return end
    
    local npcHum = SelectedNPC.Humanoid
    local npcHRP = SelectedNPC.HRP
    if not npcHum or not npcHRP then return end
    
    if direction.Magnitude < 0.1 then
        npcHum:Move(Vector3.new(0, 0, 0), false)
        return
    end
    
    if HasF3X then
        -- با F3X حرکت بده → همه می‌بینن
        local speed = 16
        local newPos = npcHRP.Position + direction.Unit * speed * 0.1
        
        -- با F3X قطعه رو جابه‌جا کن (Sync میشه)
        _({
            [1] = "SyncMove",
            [2] = {
                [1] = {
                    ["Part"] = npcHRP,
                    ["Position"] = newPos,
                    ["Rotation"] = npcHRP.CFrame
                }
            }
        })
    end
    
    -- همیشه Humanoid:Move هم بزن (برای انیمیشن راه رفتن)
    npcHum:Move(direction.Unit, false)
end

-- ============================================================
-- ===== حلقه اصلی =====
-- ============================================================
RunService.Heartbeat:Connect(function(dt)
    if not IsInNPC then return end
    if not SelectedNPC or not SelectedNPC.Model.Parent then return end
    
    -- دوربین رو روی NPC نگه دار
    if Camera.CameraSubject ~= SelectedNPC.Humanoid then
        Camera.CameraSubject = SelectedNPC.Humanoid
    end
    
    -- حرکت با جوی‌استیک بازیکن
    local char = LocalPlayer.Character
    if char then
        local playerHum = char:FindFirstChildOfClass("Humanoid")
        if playerHum then
            local moveDir = playerHum.MoveDirection
            
            if moveDir.Magnitude > 0.1 then
                if tick() - LastMoveTime > 0.05 then
                    MoveNPC(moveDir)
                    LastMoveTime = tick()
                end
            else
                SelectedNPC.Humanoid:Move(Vector3.new(0, 0, 0), false)
            end
        end
    end
end)

