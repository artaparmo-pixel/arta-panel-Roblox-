-- پیدا کردن F3X
local tool
for _, v in ipairs(LocalPlayer:GetDescendants()) do 
    if v.Name == "SyncAPI" then tool = v.Parent break end 
end
if not tool then 
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do 
        if v.Name == "SyncAPI" then tool = v.Parent break end 
    end 
end
if not tool or not tool:FindFirstChild("SyncAPI") then 
    warn("❌ F3X پیدا نشد! F3X رو توی بازی باز کن") 
    return 
end

local remote = tool.SyncAPI.ServerEndpoint
print("✅ F3X پیدا شد!")

-- ============================================================
-- متغیرها
-- ============================================================
local OrbitBlock = nil
local Angle = 0
local RenderName = "ArtaOrbit_" .. tostring(math.random(1000, 9999))
local IsActive = false

local Settings = {
    Color = Color3.fromRGB(0, 200, 255),
    Speed = 3,
    Radius = 6,
    Height = 3,
    Size = 2,
    Material = Enum.Material.Neon,
    LightEnabled = true,
    Bobbing = true,
}

-- ============================================================
-- ساخت بلوک
-- ============================================================
local function CreateOrbitBlock()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local cframe = hrp.CFrame * CFrame.new(0, 5, 5)
    local block = remote:InvokeServer("CreatePart", "Normal", cframe, char)
    
    if not block then
        warn("❌ بلوک ساخته نشد")
        return nil
    end
    
    remote:InvokeServer("SyncResize", {{Part = block, Size = Vector3.new(Settings.Size, Settings.Size, Settings.Size), CFrame = cframe}})
    remote:InvokeServer("SyncColor", {{Part = block, Color = Settings.Color}})
    remote:InvokeServer("SyncMaterial", {{Part = block, Material = Settings.Material}})
    remote:InvokeServer("SyncAnchor", {{Part = block, Anchored = true}})
    remote:InvokeServer("SyncCollision", {{Part = block, CanCollide = false}})
    
    if Settings.LightEnabled then
        remote:InvokeServer("CreateLight", {{Part = block, Color = Settings.Color, Range = 15, Brightness = 3}})
    end
    
    return block
end

-- ============================================================
-- شروع چرخش
-- ============================================================
local function StartOrbit()
    if IsActive then return end
    if not OrbitBlock then
        OrbitBlock = CreateOrbitBlock()
        if not OrbitBlock then return end
    end
    
    IsActive = true
    Angle = 0
    
    RunService:BindToRenderStep(RenderName, Enum.RenderPriority.Character.Value + 1, function(dt)
        if not IsActive then return end
        
        local char = LocalPlayer.Character
        if not char or not char.Parent then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp or not hrp.Parent then return end
        if not OrbitBlock or not OrbitBlock.Parent then return end
        
        Angle = Angle + dt * Settings.Speed
        
        local offsetY = Settings.Height
        if Settings.Bobbing then
            offsetY = offsetY + math.sin(Angle * 2) * 1.5
        end
        
        local offset = Vector3.new(
            math.cos(Angle) * Settings.Radius,
            offsetY,
            math.sin(Angle) * Settings.Radius
)
        
        local newCFrame = CFrame.new(hrp.Position + offset) * CFrame.Angles(Angle * 2, Angle * 3, Angle)
        
        pcall(function()
            remote:InvokeServer("SyncMove", {{Part = OrbitBlock, CFrame = newCFrame}})
        end)
    end)
    
    print("✅ چرخش شروع شد! همه می‌بینن!")
end

-- ============================================================
-- توقف چرخش
-- ============================================================
local function StopOrbit()
    if not IsActive then return end
    IsActive = false
    RunService:UnbindFromRenderStep(RenderName)
    
    if OrbitBlock and OrbitBlock.Parent then
        pcall(function()
            remote:InvokeServer("Remove", {OrbitBlock})
        end)
    end
    OrbitBlock = nil
    print("⏸️ چرخش متوقف شد")
end

