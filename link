-- ===== توابع =====
local function FetchScript(link)
    local ok, res = pcall(function()
        if syn and syn.request then
            return syn.request({ Url = link, Method = "GET" }).Body
        elseif http_request then
            return http_request({ Url = link, Method = "GET" }).Body
        elseif request then
            return request({ Url = link, Method = "GET" }).Body
        else
            return HttpService:GetAsync(link)
        end
    end)
    return ok, res
end

local function SetStatus(icon, text, color)
    StatusIcon.Text = icon
    StatusText.Text = text
    StatusText.TextColor3 = color or Color3.fromRGB(255, 255, 255)
end

local function ShowLoading(show)
    LoadingFrame.Visible = show
    if show then Spinner.Rotation = 0 end
end

local PreviousScripts = {}

local function CleanPreviousScripts()
    for _, gui in ipairs(PreviousScripts) do
        pcall(function()
            if gui and gui.Parent then
                gui:Destroy()
            end
        end)
    end
    PreviousScripts = {}
end

-- ===== دکمه تایید =====
ConfirmBtn.MouseButton1Click:Connect(function()
    local link = LinkBox.Text
    
    if link == "" or link == nil then
        SetStatus("⚠️", "لطفاً لینک رو وارد کن!", Color3.fromRGB(255, 200, 50))
        return
    end
    
    if not string.find(link, "http") then
        SetStatus("⚠️", "لینک نامعتبره!", Color3.fromRGB(255, 200, 50))
        return
    end
    
    SetStatus("🧹", "پاک کردن اسکریپت قبلی...", Color3.fromRGB(255, 200, 50))
    CleanPreviousScripts()
    wait(0.3)
    
    ShowLoading(true)
    SetStatus("⏳", "در حال دریافت اسکریپت...", Color3.fromRGB(255, 200, 50))
    ConfirmBtn.Text = "⏳ در حال اجرا..."
    ConfirmBtn.Active = false
    
    spawn(function()
        local ok, res = FetchScript(link)
        local icon = "❌"
        local message = ""
        local color = Color3.fromRGB(255, 80, 80)
        
        print("===== دیباگ =====")
        print("لینک:", link)
        print("Fetch موفق؟", ok, "طول:", ok and res and #res or 0)
        
        if ok and res and #res > 0 then
            SetStatus("📥", "دریافت شد، در حال اجرا...", Color3.fromRGB(100, 200, 255))
LoadingText.Text = "در حال اجرا..."
            wait(0.3)
            
            local beforeGUIs = {}
            for _, gui in ipairs(CoreGui:GetChildren()) do
                beforeGUIs[gui] = true
            end
            
            local execOk, execErr = pcall(function() loadstring(res)() end)
            
            print("اجرا موفق؟", execOk)
            if not execOk then
                print("خطا:", tostring(execErr))
            end
            print("================")
            
            if execOk then
                icon = "✅"
                message = "اسکریپت با موفقیت اجرا شد!"
                color = Color3.fromRGB(80, 255, 80)
                ConfirmBtn.Text = "✅ اجرا شد"
                
                wait(0.5)
                for _, gui in ipairs(CoreGui:GetChildren()) do
                    if not beforeGUIs[gui] and gui:IsA("ScreenGui") then
                        if gui.Name ~= "Panel" and gui.Name ~= "LinkPanel" then
                            table.insert(PreviousScripts, gui)
                        end
                    end
                end
            else
                icon = "❌"
                message = "خطا: " .. tostring(execErr):sub(1, 50)
                ConfirmBtn.Text = "❌ خطا در اجرا"
            end
        else
            icon = "❌"
            message = "خطا در دریافت لینک!"
            ConfirmBtn.Text = "❌ خطا در دریافت"
        end
        
        ShowLoading(false)
        SetStatus(icon, message, color)
        
        wait(5)
        ConfirmBtn.Text = "▶️ تایید و اجرا"
        ConfirmBtn.Active = true
    end)
end)

