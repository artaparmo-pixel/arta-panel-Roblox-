local function popIn(frame, targetSize)
    frame.Size = UDim2.new(0, 0, 0, 0)
    frame.Visible = true
    tween(frame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = targetSize })
end

local function popOut(frame, onComplete)
    local t = tween(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = UDim2.new(0, 0, 0, 0) })
    t.Completed:Connect(function()
        frame.Visible = false
        if onComplete then onComplete() end
    end)
end

