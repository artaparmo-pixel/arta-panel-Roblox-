local dragging = false
local dragStartX = 0
local dragStartY = 0
local frameStartX = 0
local frameStartY = 0

TitleBar.MouseButton1Down:Connect(function(x, y)
    dragging = true
    dragStartX = x
    dragStartY = y
    frameStartX = MainFrame.Position.X.Offset
    frameStartY = MainFrame.Position.Y.Offset
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local deltaX = input.Position.X - dragStartX
        local deltaY = input.Position.Y - dragStartY
        MainFrame.Position = UDim2.new(
            MainFrame.Position.X.Scale,
            frameStartX + deltaX,
            MainFrame.Position.Y.Scale,
            frameStartY + deltaY
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

