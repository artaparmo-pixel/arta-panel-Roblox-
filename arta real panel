}local function PlayMusic()
    pcall(function()
        if MusicSound then MusicSound:Stop() MusicSound:Destroy() end
        if loopConn then loopConn:Disconnect() loopConn = nil end
        MusicSound = Instance.new("Sound")
        MusicSound.SoundId = "rbxassetid://" .. MusicId
        MusicSound.Volume = 1
        MusicSound.Parent = SoundService
        MusicSound:Play()
        isMusicLoop = true
        loopConn = MusicSound.Ended:Connect(function()
            if isMusicLoop then PlayMusic() end
        end)
    end)
end

local function StopMusic()
    pcall(function()
        isMusicLoop = false
        if loopConn then loopConn:Disconnect() loopConn = nil end
        if MusicSound then MusicSound:Stop() MusicSound:Destroy() MusicSound = nil end
    end)
end

local function SendChat(msg)
    pcall(function()
        local chat = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if chat and chat:FindFirstChild("SayMessageRequest") then
            chat.SayMessageRequest:FireServer(msg, "All")
        end
    end)
    pcall(function()
        local TextChatService = game:GetService("TextChatService")
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channel = TextChatService.TextChannels.RBXGeneral
            if channel then channel:SendAsync(msg) end
        end
    end)
end

local function FetchScript(link)
    local ok, res = pcall(function()
        if syn and syn.request then
            return syn.request({ Url = link, Method = "GET" }).Body
        elseif http_request then
            return http_request({ Url = link, Method = "GET" }).Body
        elseif request then
            return request({ Url = link, Method = "GET" }).Body
        else
            return HttpService:GetAsync(link)
        end
    end)
    return ok, res
end

